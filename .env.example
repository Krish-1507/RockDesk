# Copy to .env and fill in real values. Never commit .env.
# Supabase project settings (dashboard) — public values:
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_DIRECT_CONNECTION_STRING=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# Derived / server values:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-or-secret-key
# LLM (Groq): provide at least one; the second is automatic fallback:
GROQ_API_KEY=gsk_...
GROQ_FALLBACK_API_KEY=gsk_...
LLM_MODEL=openai/gpt-oss-120b
# App:
APP_TIMEZONE_DEFAULT=Asia/Kolkata
AI_RATE_LIMIT_PER_MINUTE=20
CORS_ORIGINS=http://localhost:3000
PORT=4000
